# ---- Build stage ----
# Construir con: docker buildx build --platform linux/amd64 -f Dockerfile.amd64 -t fichajespi_back:latest .
FROM --platform=linux/amd64 maven:3.9-eclipse-temurin-17 AS build
COPY src /home/app/src
COPY pom.xml /home/app
RUN mvn -f /home/app/pom.xml clean package -DskipTests

# ---- Runtime stage (distroless: sin shell, sin gestor de paquetes, solo JRE + app) ----
FROM --platform=linux/amd64 gcr.io/distroless/java17-debian12
COPY --from=build /home/app/target/fichajesPi.backend-0.0.1-SNAPSHOT.jar /app/app.jar
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
